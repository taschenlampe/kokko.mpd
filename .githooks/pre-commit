#!/bin/bash
# Runs before every commit. It earns its keep because a QML syntax error is
# invisible here: the shell starts, the widget is simply gone -- no message.
#
#     git commit --no-verify      past it, in an emergency
#     tests/run.sh                the same check by hand, incl. the MPD smoke test
ROOT=$(git rev-parse --show-toplevel) || exit 1
exec "$ROOT/tests/run.sh" --fast
