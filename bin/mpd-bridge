#!/usr/bin/env python3
"""Line-oriented bridge between the Omarchy shell and an MPD server.

Taken from matjam/omajam (bin/omajam-mpd), MIT License,
Copyright (c) 2026 Nathan Ollerenshaw -- see NOTICE.md in this plugin. The
protocol, the MPD handling and the cover caching are theirs; only the caller
changed: this plugin's BarWidget instead of the shell's plugin service.

The shell speaks to this over the child process's stdin/stdout, one JSON
object per line in each direction. It exists because Quickshell's Socket is a
QLocalSocket -- unix sockets only -- and MPD is usually reached over TCP.
Doing it here rather than shelling out to `mpc` per update also means the
plugin has no package dependency beyond python3, and updates arrive by MPD's
own `idle` push rather than by polling.

Two connections are held, which is what MPD's protocol asks for: one parked in
`idle` waiting for the server to say something changed, and one for commands
and status. Sharing a single connection would mean cancelling the idle with
`noidle` around every button press and racing the reply against the event.

A third connection answers the client's browsing queries. `find` across a ten
thousand song library takes long enough to be felt, and it must not be felt on
the play button, so queries get their own socket and their own worker thread.
Requests carry a `channel`, and a request superseded by a newer one on the same
channel is dropped rather than run -- which is what makes typing in the search
box cost one query rather than one per keystroke.

Album art is fetched on its own short-lived fourth connection, off both paths,
so a 4MB cover cannot delay a play/pause either.

One query has nothing to do with MPD: `radio_search` asks the public
radio-browser.info directory over HTTPS for stations and hands them back the
same way the browsing queries hand back songs. It runs on the query worker like
the others, but its HTTP call carries its own hard ceiling (see http_get),
because a socket that never answers must cost one reply -- never the bridge.

The same directory answers one question for the art worker: which station is
behind the stream that is playing? Its records carry `favicon`, and that logo
is fetched into the album-art cache and announced like any other cover (issue
#56). The records disagree -- one stream address can match several, and the
first favicon is not the good one -- so the logo is a *chain* of candidates,
tried in turn until one is an image (follow-up to #56). Only the running stream
is resolved -- never a row in the radio tab.

Input (stdin, one line each):
    config {"host":..,"port":..,"password":..}   (re)connect with these settings
    toggle | play | pause | stop | next | prev
    seek <seconds>            absolute, in the current song
    volume <0-100>
    setopt <repeat|random|single|consume> <value>
    update [path] | rescan [path]   (re)scan the library, optionally one folder
    refresh                   re-emit state now
    cmd <json>                one queue/library mutation, see COMMANDS below
    query <json>              {"id":..,"kind":..,"channel":..,..} -- see QUERIES
    quit

COMMANDS (the "op" key of `cmd`):
    playid {id} | playpos {pos} | add {uri} | addplay {uri} | insert {uri}
    findadd {filter} | findplay {filter}
    remove {id} | move {from,to} | clear | shuffle | crop
    loadplaylist {name} | saveplaylist {name} | rmplaylist {name}
    renameplaylist {name,to} | playlistadd {name,uri}
    playlistdelete {name,pos} | playlistclear {name}
    searchadd {term}
    (note: `playlistdelete`, `playlistclear` and `searchadd` are additions of this plugin)

QUERIES (the "kind" key of `query`):
    queue                     the play queue, in order
    lsinfo {path}             one directory of the music tree
    list {tag,filter}         distinct values of a tag, optionally filtered
    find {filter,sort}        songs matching an exact-match filter
    search {term}             songs matching a substring of any tag
    songinfo {file}           every tag MPD holds for one song
    art {uri}                 the cover for one song, cached
    listplaylists             stored playlists
    playlist {name}           one stored playlist's songs
    radio_search {search,country,tag,limit}
                              stations from radio-browser.info, the public
                              directory -- HTTP, no key, and (the one query
                              that is) nothing to do with MPD

Output (stdout, one JSON object per line):
    {"event":"connected","version":..,"target":..}
    {"event":"disconnected","error":..,"retryIn":..}
    {"event":"state","status":{..},"song":{..}}
    {"event":"art","uri":..,"path":..,"mime":..}
    {"event":"result","id":..,"kind":..,"channel":..,"rows":[..],"error":..}
    {"event":"database"}      the library changed; anything showing it is stale
    {"event":"health","ok":..,"detail":..}
                              the daemon answered/stopped answering its greeting;
                              see HEALTH_INTERVAL -- `connected` does not say this
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import socket
import sys
import threading
import time
import urllib.parse
import urllib.request

# Enough for any sane cover. A pathological file should degrade to "no art"
# rather than to a shell holding tens of megabytes of it.
ART_LIMIT = 12 * 1024 * 1024
ART_CACHE_KEEP = 96
ART_PART_SUFFIX = ".part"   # the temp name of a write that has not landed yet
ART_PART_AGE = 3600         # a `.part` this old belongs to a writer that died
ART_CHUNK = 256 * 1024

CMD_TIMEOUT = 10.0
CONNECT_TIMEOUT = 5.0

# MPD closes an idle *command* connection after `connection_timeout`, 60 seconds
# by default (this plugin's own mpd.conf sets none). A write to a peer that has
# just gone away still succeeds -- the local socket has not been told yet -- and
# only the read learns of the close, so the command looks delivered while the
# press vanishes. Replace the socket before it is used once it has sat idle this
# long: comfortably under MPD's 60 s, and above the gap between two button
# presses so the ordinary case never pays for it.
CMD_IDLE_RENEW = 45.0

# Floor on the gap between two status reads. A database update or a client
# dragging the seek bar can fire idle events far faster than anything on a bar
# can be read, and the refreshes coalesce rather than queue up behind it.
REFRESH_MIN_GAP = 0.1

# A ceiling on one query's answer. The whole-library queries are the point of
# the browser, so this is generous; it exists so a pathological database cannot
# hand the shell a hundred megabytes of JSON on one line.
QUERY_ROW_LIMIT = 20000

# The public station directory the radio search asks. No key, no account, and
# the `all` host is the load-balanced one the project points clients at; the
# plugin keeps no list of mirrors to go stale. radio-browser asks callers to
# identify themselves with a User-Agent -- a bare urllib request is refused.
RADIO_API = "https://all.api.radio-browser.info"
RADIO_PATH = "/json/stations/search"
# The other question the same directory answers: given a stream address, which
# station is it? That record carries `favicon`, the station's logo.
RADIO_BYURL_PATH = "/json/stations/byurl"
RADIO_UA = "kokko.mpd/0.1 (+https://github.com/taschenlampe/kokko.mpd)"
# One HTTP request: connect and read. Short on purpose -- this is a search box
# somebody is typing in, not a download.
RADIO_TIMEOUT = 8.0
# How long past that the watchdog waits before it calls the fetch dead. See
# http_get: urlopen's timeout does not cover name resolution.
RADIO_GRACE = 2.0
# No radio answer is worth buffering unbounded.
RADIO_MAX_BYTES = 4 * 1024 * 1024
# A station logo is fetched while a stream plays, off the play/pause path, but
# still with its own ceiling: measured logos run to 400 KB, and a favicon URL
# that answers with something else must not be buffered whole. One byte past the
# ceiling is read so an oversize body can be told apart from one at the limit.
RADIO_FAVICON_TIMEOUT = 6.0
RADIO_FAVICON_MAX = 512 * 1024
# The directory answers one stream address with several records, and they do not
# agree, so the logo is a chain of candidates (see radio_favicon_candidates) and
# the first image wins. This is the cap on how many of them one stream may cost:
# a directory that lists the same address a dozen times must not turn into a
# dozen fetches on a stream that is playing.
RADIO_ART_CANDIDATES = 4
RADIO_ROW_LIMIT = 200

# The liveness probe for the daemon itself. MPD can accept a connection on its
# control port and then never send the greeting: a reset internet-radio stream can
# wedge it that way, and while it is wedged `systemctl --user is-active mpd` still
# says active, the process burns no CPU, and nobody on the MPD protocol is told.
# An idle socket has no timeout by design, so the plugin would keep showing the
# last title as if it were current. The one question with an answer is this one:
# does the greeting arrive? Two misses in a row are a verdict (a single stalled
# moment is not a wedge), and the answer goes out once per change as `health`.
HEALTH_INTERVAL = 20.0
HEALTH_TIMEOUT = 3.0
HEALTH_FAILS = 2

# What travels with a song. MPD volunteers more than this -- Added, sticker
# counts, the audio format -- and every field costs bytes on a line that can
# carry ten thousand of them.
SONG_FIELDS = (
    "file", "id", "pos", "title", "artist", "albumartist", "album",
    "track", "disc", "date", "genre", "composer", "performer", "name",
    "time", "duration", "last-modified",
)

# The keys that start a new entry in a multi-entry response.
ENTRY_MARKERS = ("file", "directory", "playlist")

# Subsystems worth waking for. `database` and `update` are included so the
# panel's rescan button shows progress; `message` and `sticker` are not.
IDLE_SUBSYSTEMS = ["player", "mixer", "options", "playlist", "update", "database"]


class MPDError(Exception):
    """Connection-level failure. The connection is no longer usable."""


class MPDCommandError(MPDError):
    """An ACK from the server. The connection is fine; the command was not."""


ACK_PATTERN = re.compile(r"^\[(\d+)@(\d+)\]\s*\{([^}]*)\}\s*(.*)$")


def ack_message(body: str) -> str:
    """The human half of `ACK [3@0] {password} incorrect password`.

    The panel shows this verbatim, and "incorrect password" is advice while
    "[3@0] {password} incorrect password" is a protocol dump.
    """
    match = ACK_PATTERN.match(body.strip())
    if not match:
        return body.strip()
    text = match.group(4).strip()
    command = match.group(3).strip()
    if text and command:
        return "%s: %s" % (command, text)
    return text or body.strip()


def error_text(exc: BaseException) -> str:
    """A message for the settings panel rather than for a log.

    OSError stringifies as "[Errno 111] Connection refused"; its strerror is
    the half a person needs, and the panel is where this ends up.
    """
    strerror = getattr(exc, "strerror", None)
    if strerror:
        return str(strerror)
    return str(exc) or exc.__class__.__name__


def quote(value) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def parse_target(host: str, port) -> tuple:
    """Resolve the host/port pair into a socket target.

    A leading `/` or `~` means a unix socket, `@` an abstract one -- the same
    spellings MPD_HOST accepts, so a value copied from a shell profile works
    here unchanged.
    """
    host = (host or "").strip()
    if host.startswith("~"):
        host = os.path.expanduser(host)
    if host.startswith("/"):
        return ("unix", host)
    if host.startswith("@"):
        return ("unix", "\0" + host[1:])
    try:
        port = int(port)
    except (TypeError, ValueError):
        port = 6600
    return ("tcp", host or "127.0.0.1", port)


def describe(target: tuple) -> str:
    if target[0] == "unix":
        return target[1].replace("\0", "@")
    return "%s:%d" % (target[1], target[2])


class MPDConn:
    """One MPD connection. Not thread-safe; callers hold a lock or own it."""

    def __init__(self, target: tuple, password: str = ""):
        self.target = target
        self.password = password or ""
        self.sock = None
        self.fh = None
        self.version = ""
        # True from the moment a command is on the wire until its reply is
        # complete. It is the one thing that tells a retry apart from a
        # duplicate: an error before the write proves nothing was executed,
        # an error after it proves nothing at all.
        self.in_flight = False
        # When a command last completed on this connection, monotonic. The
        # command socket is renewed once it has been idle past CMD_IDLE_RENEW,
        # which is the only cheap way to tell a live peer from one MPD has
        # already hung up on: the write to the latter still succeeds.
        self.last_used = 0.0
        # Set once the connection is retired or closed. Whoever reads or writes
        # asks this first, so a socket taken away by another thread is a
        # connection error to them and not a crash on a handle that just
        # became None.
        self.closed = threading.Event()
        # How many reads are in progress. A drop uses it to decide whether the
        # handles may be closed now or belong to the thread reading them.
        self.readers = 0

    def connect(self, timeout: float = CONNECT_TIMEOUT) -> str:
        if self.target[0] == "unix":
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect(self.target[1])
        else:
            sock = socket.create_connection((self.target[1], self.target[2]), timeout)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            # Nagle waits for an ACK before sending a second small packet,
            # and the peer's delayed ACK waits ~40ms for data to piggyback
            # on. In a request/response protocol they wait for each other:
            # album art measured 11 seconds over a local socket with this
            # left on, and milliseconds with it off.
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.sock = sock
        self.fh = sock.makefile("rb")
        greeting = self.readline()
        if not greeting.startswith("OK MPD "):
            self.close()
            raise MPDError("unexpected greeting from server")
        self.version = greeting[len("OK MPD "):].strip()
        # Sent before anything else: without it every later command ACKs with
        # "you don't have permission", which would read as a broken server.
        if self.password:
            self.command("password", self.password)
        return self.version

    def close(self) -> None:
        self.closed.set()
        for handle in (self.fh, self.sock):
            try:
                if handle is not None:
                    handle.close()
            except OSError:
                pass
        self.fh = None
        self.sock = None

    def retire(self) -> None:
        """Mark the connection dead and wake a read another thread is in.

        A settings change drops sockets its readers may be sitting in: the
        query worker between two requests, or in the middle of one. Closing the
        handles from here would pull them out from under that read -- the
        worker used to wake up on a `None` and die with the browse tabs. So
        this only marks the connection dead and breaks the blocked read; the
        flag turns whatever comes next into a connection error, and the thread
        that owns the socket closes what is left of it.
        """
        self.closed.set()
        self.shutdown()

    def shutdown(self) -> None:
        """Break a blocking read from another thread."""
        try:
            if self.sock is not None:
                self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def read_stream(self):
        """The buffered reader, or a connection error. Never returns None.

        A connection that was closed while another thread held it has to read
        as "the connection is gone" rather than as an `AttributeError` on
        `None` in whichever thread reads next.
        """
        fh = self.fh
        if fh is None or self.closed.is_set():
            raise MPDError("connection closed")
        return fh

    def readline(self) -> str:
        fh = self.read_stream()
        self.readers += 1
        try:
            # A retire that ran between the check above and this read: there is
            # nothing left to read, so do not start.
            if self.closed.is_set():
                raise MPDError("connection closed")
            try:
                line = fh.readline()
            except ValueError as exc:
                # The descriptor went away under the read. Whatever the file
                # object calls it, the connection is gone.
                raise MPDError("connection closed") from exc
        finally:
            self.readers -= 1
        # A retire that happened while this read was waiting for its line: the
        # answer belongs to a connection the bridge no longer believes in, and
        # what is left of the reply would desync the next command.
        if self.closed.is_set():
            raise MPDError("connection closed")
        if not line:
            raise MPDError("connection closed by server")
        return line.decode("utf-8", "replace").rstrip("\r\n")

    def read_bytes(self, count: int) -> bytes:
        """Exactly `count` bytes, with the same care as readline."""
        try:
            data = self.read_stream().read(count)
        except ValueError as exc:
            raise MPDError("connection closed") from exc
        if data is None or len(data) != count:
            raise MPDError("short binary read")
        return data

    def send(self, text: str) -> None:
        sock = self.sock
        if sock is None or self.closed.is_set():
            # The same guard as on the read side: `sendall` on a None is an
            # AttributeError nobody catches, and a closed connection is an
            # ordinary connection error.
            raise MPDError("connection closed")
        try:
            sock.sendall((text + "\n").encode("utf-8"))
        except OSError as exc:
            raise MPDError(str(exc)) from exc
        # Past this line a lost reply no longer means the command did not run.
        self.in_flight = True

    def command(self, name: str, *args) -> tuple:
        """Run one command. Returns (pairs, binary-or-None)."""
        self.send(" ".join([name] + [quote(a) for a in args]))
        return self.read_response()

    def read_response(self) -> tuple:
        pairs = []
        binary = None
        # One response is one read, from whichever thread owns the socket, so
        # a drop elsewhere can see that this handle is in use.
        self.readers += 1
        try:
            while True:
                try:
                    line = self.readline()
                except socket.timeout as exc:
                    raise MPDError("timed out waiting for a reply") from exc
                except OSError as exc:
                    raise MPDError(str(exc)) from exc
                if line == "OK":
                    # The exchange is over: the socket is at a command boundary
                    # again, so the next failure is judged on its own.
                    self.in_flight = False
                    return pairs, binary
                if line.startswith("ACK "):
                    # The server answered -- it understood the command and refused
                    # it. Nothing to repeat, and nothing left half-read.
                    self.in_flight = False
                    raise MPDCommandError(ack_message(line[4:]))
                if ": " not in line:
                    continue
                key, value = line.split(": ", 1)
                if key == "binary":
                    count = int(value)
                    if count < 0 or count > ART_LIMIT:
                        raise MPDError("refusing a %d byte binary chunk" % count)
                    binary = self.read_bytes(count)
                    # MPD terminates the chunk with a newline that is not part of
                    # the payload; leaving it would desync every later reply.
                    self.read_bytes(1)
                pairs.append((key, value))
        finally:
            self.readers -= 1


class CommandConn:
    """The command connection as one callback sees it.

    A callback is not one command. `find_add` reads the queue length, adds and
    reads it again; `add_and_play` does the same and may follow with a `play`.
    The retry has to belong to the command, because running the callback again
    runs the commands that already did their work -- measured before this
    existed: a failure writing the second queue read re-ran `find_add` from the
    top and `findadd` appended the whole artist twice.

    So the callback talks to this handle, and every `command` is one round trip
    that can ask the bridge for a fresh socket without replaying anything else.
    `version` reads through to the live connection, since `search_add` and
    `filter_args` branch on the server version.

    `repeated` records that a command of this callback has already been sent a
    second time, so the failure report can say so rather than claiming the
    command was not repeated when the transport retry above it did repeat it.
    """

    __slots__ = ("bridge", "conn", "repeated")

    def __init__(self, bridge: "Bridge", conn: MPDConn):
        self.bridge = bridge
        self.conn = conn
        self.repeated = False

    @property
    def version(self) -> str:
        return self.conn.version

    def command(self, name: str, *args, repeatable: bool = False) -> tuple:
        return self.bridge.cmd_call(self, name, args, repeatable)


def to_dict(pairs) -> dict:
    """Fold response pairs into a dict, joining repeats.

    A song can carry several Artist or Genre lines. Joining rather than
    keeping the last one means a collaboration reads as both names.
    """
    out = {}
    for key, value in pairs:
        key = key.lower()
        if key in out:
            if value not in out[key].split(", "):
                out[key] = out[key] + ", " + value
        else:
            out[key] = value
    return out


# --------------------------------------------------------------------- queries


def add_field(entry: dict, key: str, value: str) -> None:
    """Set or extend one field, folding repeats the way to_dict does."""
    if key in entry:
        if value not in entry[key].split(", "):
            entry[key] = entry[key] + ", " + value
    else:
        entry[key] = value


def split_entries(pairs, markers=ENTRY_MARKERS, fields=None, limit=QUERY_ROW_LIMIT) -> list:
    """Cut a multi-entry response into one dict per entry.

    MPD answers `playlistinfo` and `lsinfo` as one flat stream of pairs, and
    the only thing separating two songs is that a second `file` appeared. Folding
    the lot into a single dict -- which is what to_dict does, and the right
    answer for `status` -- would lose every entry but the last.
    """
    entries = []
    current = None
    for key, value in pairs:
        key = key.lower()
        if key in markers:
            if len(entries) >= limit:
                break
            current = {"type": key, key: value}
            entries.append(current)
        elif current is not None:
            if fields is None or key in fields:
                add_field(current, key, value)
    return entries


def tag_values(pairs, tag: str, limit=QUERY_ROW_LIMIT) -> list:
    """The distinct values from a `list` response, in the order MPD gave them.

    An empty value is a real answer -- it is every song missing that tag -- but
    it cannot be browsed into or told apart from the others in a list, so it is
    dropped here rather than shown as a blank row.
    """
    tag = tag.lower()
    out = []
    for key, value in pairs:
        if key.lower() == tag and value != "":
            if len(out) >= limit:
                break
            out.append({"type": "value", "value": value})
    return out


def entry_name(entry: dict) -> str:
    """The path an entry is addressed by, whichever kind it is."""
    return entry.get(entry.get("type", ""), "")


def number(value) -> int:
    """A track or disc number as MPD spells it: "4", "4/12", or missing.

    Sorting is the only caller, and a number that will not parse should sort
    with the untagged rather than throw.
    """
    text = str(value or "").split("/")[0].strip()
    try:
        return int(text)
    except ValueError:
        return 0


def note_truncated(answer: dict, request: dict, rows: list) -> None:
    """Mark an answer that came back exactly as long as it was allowed to be.

    A full page is the one case where the pane cannot tell "that is everything"
    from "that is the ceiling", so it says so rather than quietly showing a
    prefix as though it were the whole answer.
    """
    try:
        if request.get("limit") and len(rows) >= int(request["limit"]):
            answer["truncated"] = True
    except (TypeError, ValueError):
        pass


def quote_filter_value(value) -> str:
    """Escape a value for the inside of MPD's filter expression quoting.

    Two layers of escaping stack here: this one, for the `'...'` the filter
    parser sees, and the protocol's own quoting applied by `quote()` on the way
    out. Applying them in this order is what makes an apostrophe in a band name
    arrive intact.
    """
    return str(value).replace("\\", "\\\\").replace("'", "\\'")


def contains_expression(tag: str, term: str) -> str:
    """A case-insensitive substring filter over one tag.

    `contains` compares case-sensitively in a `list` filter (measured: "iam" missed
    the artist "IAM" -- 5 hits instead of 6), while `=~` with an inline flag finds
    either spelling. The whole expression has to stay one argument: MPD splits its
    arguments on spaces and the filter parser then chokes on the quotes. Regex
    characters in the term are escaped, so searching for "AC/DC + live" looks for
    that text and not for a pattern.
    """
    return "(%s =~ '(?i)%s')" % (tag, quote_filter_value(re.escape(term)))


def version_at_least(version: str, major: int, minor: int) -> bool:
    parts = (version or "").split(".")
    try:
        return (int(parts[0]), int(parts[1])) >= (major, minor)
    except (IndexError, ValueError):
        return False


# ------------------------------------------------------------------- album art


def is_stream_uri(uri: str) -> bool:
    """A live internet stream: MPD hands out the http(s) address as `file`."""
    return bool(re.match(r"https?://", uri or "", re.IGNORECASE))


def stream_art_key(uri: str) -> str:
    """The cache identity of a stream's logo: the whole address, hashed.

    An album key is the directory plus the album, because every track of a
    release shares one picture. A radio stream has no album, and two stations
    can sit at the same host -- SomaFM's `ice5.somafm.com` serves both Groove
    Salad and Drone Zone -- so the album rule would give two stations one logo.
    The full URL is the identity here.
    """
    return hashlib.sha1(("stream\n" + uri).encode("utf-8")).hexdigest()[:20]


def art_key(song: dict) -> str:
    """Identity of the artwork, not of the song.

    Keyed on the song's directory plus album so every track of an album shares
    one cache entry -- which is what `albumart` returns anyway. The album tag
    is in there because two albums can sit in one directory. A stream is not a
    song in an album at all: it is keyed on its own URL (see stream_art_key).
    """
    uri = song.get("file", "")
    if is_stream_uri(uri):
        return stream_art_key(uri)
    directory = uri.rsplit("/", 1)[0] if "/" in uri else ""
    parts = [directory, song.get("album", ""), song.get("albumartist", "")]
    if not directory:
        parts.append(uri)
    return hashlib.sha1("\n".join(parts).encode("utf-8")).hexdigest()[:20]


def cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "kokko-mpd")
    os.makedirs(path, exist_ok=True)
    return path


def extension_for(data: bytes, mime: str) -> str:
    if data[:2] == b"\xff\xd8":
        return ".jpg"
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return ".png"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return ".webp"
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return ".gif"
    mime = (mime or "").lower()
    for needle, ext in (("jpeg", ".jpg"), ("png", ".png"), ("webp", ".webp")):
        if needle in mime:
            return ext
    return ".img"


def cached_art(key: str) -> str:
    directory = cache_dir()
    try:
        for name in os.listdir(directory):
            # A `.part` is a write still in progress, not an answer. The test
            # here is only "starts with the key", so it matched those too -- with
            # a finished cover and a leftover beside it, 300 of 300 lookups
            # handed out the `.part`.
            if name.startswith(key + ".") and not name.endswith(ART_PART_SUFFIX):
                return os.path.join(directory, name)
    except OSError:
        pass
    return ""


_art_tmp_seq = 0
_art_tmp_lock = threading.Lock()


def art_tmp_path(path: str) -> str:
    """A temp name for one write -- one no other writer can be using.

    Both writers used `path + ".part"`: the art thread of a refresh and the
    browse query for a cover. Two of them on the same album then took the file
    from each other, the slower one's `os.replace` found its source gone, and the
    OSError was read as "no cover" although the finished cover sat on disk. The
    token counts writes, not threads, so nothing has to be unique about the
    writer -- only about the write.
    """
    global _art_tmp_seq
    with _art_tmp_lock:
        _art_tmp_seq += 1
        seq = _art_tmp_seq
    return "%s.%d.%d%s" % (path, os.getpid(), seq, ART_PART_SUFFIX)


def prune_cache() -> None:
    directory = cache_dir()
    try:
        names = os.listdir(directory)
        # Files, not cache entries. A `.part` counted as an entry, so a directory
        # with covers and temp files in it kept the temp files and deleted the
        # covers -- the prune threw away exactly what the cache is for. A temp
        # file of a write that is running right now must survive it, so one that
        # is not is collected by age instead; nothing writes an hour-old file.
        now = time.time()
        for name in names:
            if not name.endswith(ART_PART_SUFFIX):
                continue
            stale = os.path.join(directory, name)
            if now - os.path.getmtime(stale) > ART_PART_AGE:
                os.unlink(stale)
        entries = [os.path.join(directory, n) for n in names
                   if not n.endswith(ART_PART_SUFFIX)]
        if len(entries) <= ART_CACHE_KEEP:
            return
        entries.sort(key=lambda p: os.path.getmtime(p))
        for path in entries[: len(entries) - ART_CACHE_KEEP]:
            os.unlink(path)
    except OSError:
        pass


def store_art(key: str, data: bytes, mime: str) -> str:
    """Write fetched artwork into the cache and return its path.

    One writer per call: the temp name comes from art_tmp_path, so two fetches
    of the same picture cannot take the file from each other, and the rename
    lands it whole (see art_tmp_path). The prune runs here because a write is
    the only thing that can push the cache over its keep.
    """
    path = os.path.join(cache_dir(), key + extension_for(data, mime))
    tmp = art_tmp_path(path)
    with open(tmp, "wb") as handle:
        handle.write(data)
    os.replace(tmp, path)
    prune_cache()
    return path


def fetch_binary(conn: MPDConn, command: str, uri: str) -> tuple:
    """Pull one of MPD's chunked binary responses in full."""
    data = bytearray()
    mime = ""
    size = None
    while True:
        pairs, chunk = conn.command(command, uri, len(data))
        fields = to_dict(pairs)
        if "size" in fields:
            try:
                size = int(fields["size"])
            except ValueError:
                size = None
        if "type" in fields:
            mime = fields["type"]
        if not chunk:
            break
        data += chunk
        if len(data) > ART_LIMIT:
            raise MPDError("album art larger than %d bytes" % ART_LIMIT)
        if size is not None and len(data) >= size:
            break
    return bytes(data), mime


# MPD hands out only the cover files it knows by name. MPD 0.24 knows `cover.*`
# -- a perfectly good `folder.jpg` next to the song is invisible to `albumart`
# (measured: "No file exists" for folder.jpg, album.jpg, "Album Art.jpg"; the same
# bytes answer `size: 25872` the moment a cover.jpg exists). The bridge runs on the
# same machine as the library, so it can read the usual names itself.
#
# Best coverage first; the first pattern that matches wins. Within one pattern the
# largest file wins, because that is normally the least cropped scan. Names that
# usually show the *wrong* side of a booklet ("Back Cover", "Inside", "CD",
# "…Small") are kept, but ranked behind everything else -- an album that only has
# one of those should still show something.
COVER_PATTERNS = (
    r"^(cover|front|folder|album|album art|albumart|artwork)$",
    r"front[ _-]*(cover|art)",
    r"(cover|artwork|album[ _-]*art)",
    r"^(case|scan|cd|thumb)$",
)
COVER_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")
COVER_WEAK = ("back", "inside", "inlay", "booklet", "small", "disc", "thumb", "cd")

_MUSIC_DIR = None  # cached result of music_directory()


def music_directory() -> str:
    """MPD's `music_directory`, read from its own configuration file.

    The `config` command needs admin rights, and the answer is a path on this
    machine anyway -- so the file is read directly. Empty when nothing readable
    is found, which simply disables the disk fallback.
    """
    global _MUSIC_DIR
    if _MUSIC_DIR is not None:
        return _MUSIC_DIR
    config_root = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    candidates = (
        os.path.join(config_root, "mpd", "mpd.conf"),
        os.path.expanduser("~/.mpdconf"),
        "/etc/mpd.conf",
    )
    found = ""
    for path in candidates:
        try:
            with open(path, encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    line = line.split("#", 1)[0].strip()
                    if not line.startswith("music_directory"):
                        continue
                    value = line.split(None, 1)[1] if len(line.split(None, 1)) > 1 else ""
                    value = os.path.expanduser(value.strip().strip('"').strip("'"))
                    if value and os.path.isdir(value):
                        found = value
                    break
        except OSError:
            continue
        if found:
            break
    _MUSIC_DIR = found
    return found


def local_cover(uri: str) -> tuple:
    """The best cover image sitting beside the song, read from disk.

    Only a fallback for what `albumart` will not hand out. Everything a media
    player in the wild writes is fair game here -- `folder.jpg`, `Album Art.jpg`,
    `AlbumArt_{GUID}_Large.jpg`, `Artist - Album - Front Cover.jpg`. The picks
    are ranked by COVER_PATTERNS, then by file size among equals. Returns
    (data, mime), empty when there is nothing to read.
    """
    base = music_directory()
    if not base or not uri:
        return b"", ""
    directory = os.path.join(base, os.path.dirname(uri))
    try:
        names = os.listdir(directory)
    except OSError:
        return b"", ""

    images = []
    for name in names:
        stem, ext = os.path.splitext(name)
        if ext.lower() not in COVER_EXTS:
            continue
        try:
            size = os.path.getsize(os.path.join(directory, name))
        except OSError:
            continue
        images.append((stem.lower(), os.path.join(directory, name), size))
    if not images:
        return b"", ""

    def rank(image: tuple) -> tuple:
        stem, _path, size = image
        weak = any(word in stem for word in COVER_WEAK)
        for index, pattern in enumerate(COVER_PATTERNS):
            if re.search(pattern, stem):
                return (index, weak, -size)
        return (len(COVER_PATTERNS), weak, -size)

    for _stem, path, _size in sorted(images, key=rank):
        try:
            with open(path, "rb") as handle:
                data = handle.read(ART_LIMIT + 1)
        except OSError:
            continue
        if 0 < len(data) <= ART_LIMIT:
            return data, ""
    return b"", ""


def fetch_art(conn: MPDConn, uri: str) -> tuple:
    """The song's cover: `albumart`, then the file on disk, then `readpicture`.

    albumart returns the cover file sitting beside the song, which is normally
    the larger of the two; readpicture returns whatever is embedded in the tags
    and is the fallback for a library that keeps no cover files. Either can ACK
    with "no such file" and that is not an error worth reporting.

    Between the two sits the local file: MPD refuses names like `folder.jpg`, and
    that is exactly what most libraries use. Order matters -- a cover *file* is
    the better picture, so it beats the embedded one, same as MPD's own choice.
    """
    for command in ("albumart", "readpicture"):
        try:
            data, mime = fetch_binary(conn, command, uri)
        except MPDCommandError:
            data, mime = b"", ""
        if data and command == "albumart":
            return data, mime
        if command == "albumart":
            data, mime = local_cover(uri)
            if data:
                return data, mime
        elif data:
            return data, mime
    return b"", ""


# ------------------------------------------------------------ radio-browser
#
# The one part of the bridge that leaves this machine and does not speak to
# MPD. radio-browser.info is a public directory of internet radio stations --
# no key, no account -- and this asks it one question: which stations match.


class RadioError(Exception):
    """The directory could not be asked, or did not answer with stations."""


def radio_url(search: str, country: str = "", tag: str = "", limit: int = 50) -> str:
    """The search request, parameters and all.

    Built through urlencode rather than by pasting the term into a string: a
    station name with a space or an `&` in it -- which is most of them -- would
    otherwise arrive as a truncated search plus a parameter nobody asked for.
    `hidebroken` is left on: rows that cannot play are not worth the bytes.

    The name is only sent when there is one. A browse by country or by tag is a
    question the directory answers on its own (measured against the live API:
    `countrycode=DE` alone returns German stations), and an empty `name=` would
    not narrow anything -- worse, it would read as "station names containing
    nothing", which the directory has answered differently across releases.
    """
    params = [("limit", str(limit)), ("hidebroken", "true"),
              ("order", "votes"), ("reverse", "true")]
    if search:
        params.insert(0, ("name", search))
    if country:
        params.append(("countrycode", country))
    if tag:
        params.append(("tag", tag))
    return RADIO_API + RADIO_PATH + "?" + urllib.parse.urlencode(params)


def urlopen_body(url: str, timeout: float) -> bytes:
    """The blocking half of the radio fetch: one GET, read to the end.

    Broken out so the ceiling around it (http_get) can be exercised without a
    network, and so the request carries the User-Agent radio-browser asks for.
    """
    request = urllib.request.Request(
        url, headers={"User-Agent": RADIO_UA, "Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read(RADIO_MAX_BYTES)


def http_get(url: str, timeout: float = RADIO_TIMEOUT) -> bytes:
    """Fetch `url` with a ceiling the socket cannot talk its way past.

    urlopen's timeout covers the connect and every read, but not name
    resolution: getaddrinfo() runs in C and ignores it, so a resolver that has
    stopped answering parks the call for as long as *its* timeout -- minutes --
    and that is the shape of hang this bridge may not have. (MPD did exactly
    this to it once, on a socket with no ceiling at all.) So the request runs in
    its own short-lived daemon thread and this waits RADIO_GRACE past the socket
    timeout for it, then gives up and lets the thread die with the process. The
    socket timeout stays the fast path; this is the backstop.

    Everything that goes wrong -- refused, offline, DNS, a status the server
    disliked -- leaves as RadioError, so the caller has one failure to report.
    """
    result = {}

    def fetch():
        try:
            result["body"] = urlopen_body(url, timeout)
        except BaseException as exc:      # carried across, not raised here
            result["error"] = exc

    worker = threading.Thread(target=fetch, name="radio_fetch", daemon=True)
    worker.start()
    worker.join(timeout + RADIO_GRACE)
    if worker.is_alive():
        raise RadioError("radio-browser did not answer within %gs"
                         % (timeout + RADIO_GRACE))
    if "error" in result:
        raise RadioError(error_text(result["error"]))
    return result.get("body") or b""


def radio_stations(body, limit: int = 50) -> list:
    """The usable half of radio-browser's answer.

    Filtered, and the filter is the point:

    * `lastcheckok == 1` only. That is the directory's own verdict on whether
      the stream worked the last time it tried it. A station it has marked
      broken is a row that plays silence, and the search result is the wrong
      place to find that out -- worse here than in a library, because the
      stream is on somebody else's server and may simply be gone.
    * No `url_resolved`, no row. That is the address a player is handed; the
      raw `url` is whatever the submitter typed and is frequently a redirect
      or a playlist the directory could not follow. Without a resolved address
      there is nothing to play.
    * Entries that are not objects at all are skipped rather than trusted:
      this is somebody else's JSON.

    The fields are whitelisted for the same reason the song queries whitelist
    theirs -- the API sends thirty-odd per station and a list row draws ten --
    and the numbers come through `number()`, so an API that spells a bitrate
    as text cannot put a string where the panel does arithmetic.
    """
    try:
        stations = json.loads(bytes(body).decode("utf-8", "replace"))
    except (ValueError, TypeError):
        raise RadioError("radio-browser sent an answer that is not JSON")
    if not isinstance(stations, list):
        raise RadioError("radio-browser sent an answer that is not a station list")

    rows = []
    for entry in stations:
        if not isinstance(entry, dict):
            continue
        if str(entry.get("lastcheckok", 0)) != "1":
            continue
        stream = str(entry.get("url_resolved") or "").strip()
        if not stream:
            continue
        rows.append({
            "name": str(entry.get("name") or "").strip(),
            "url_resolved": stream,
            "codec": str(entry.get("codec") or ""),
            "bitrate": number(entry.get("bitrate")),
            "country": str(entry.get("country") or ""),
            "countrycode": str(entry.get("countrycode") or ""),
            "lastcheckok": 1,
            "votes": number(entry.get("votes")),
            "tags": str(entry.get("tags") or ""),
            "homepage": str(entry.get("homepage") or ""),
        })
        if len(rows) >= limit:
            break
    return rows


# ---------------------------------------------------------------- stream logo
#
# The running stream's station logo (issue #56). MPD knows nothing about it --
# a stream is not a file with a cover -- but the same public directory that
# answers the search box can be asked which station a stream address belongs to,
# and those records carry `favicon`. It answers one address with several records
# and they do not agree, so the logo is a candidate chain -- every record's
# favicon, then each record's homepage /favicon.ico -- and the first candidate
# that is an image wins (follow-up to #56). The fetch is off the play/pause path
# like the album art, and cached like any other cover: the surfaces then draw an
# ordinary image where they used to draw the glyph.


def radio_byurl_url(stream: str) -> str:
    """The byurl request for one stream address, parameters and all."""
    params = [("url", stream)]
    return RADIO_API + RADIO_BYURL_PATH + "?" + urllib.parse.urlencode(params)


def homepage_favicon(homepage: str) -> str:
    """`<scheme>://<host>/favicon.ico` for a station homepage, or "".

    The fallback for a record that carries no `favicon` -- or one whose URL is
    dead: the station's own web server very often serves its logo at the address
    every browser asks for. A homepage that is empty, a bare word like "n/a", or
    one without a scheme and a host yields nothing at all, so a broken value can
    never turn into a request.
    """
    try:
        parts = urllib.parse.urlsplit((homepage or "").strip())
    except ValueError:
        return ""
    if not parts.scheme or not parts.netloc:
        return ""
    return "%s://%s/favicon.ico" % (parts.scheme, parts.netloc)


def radio_favicon_candidates(body) -> list:
    """The logo candidates in a byurl answer, best-first, deduplicated.

    The directory answers one stream address with *several* station records and
    they do not agree: measured on streaming.smartradio.ch, the first record's
    `favicon` was a favicon.ico that answers 404 while the second's was a 30 KB
    PNG. So the first favicon is not the answer -- the answer is a chain:

      * every non-empty `favicon` of every record, in answer order;
      * then each record's homepage `<scheme>://<host>/favicon.ico`
        (see homepage_favicon).

    Two equal URLs are one candidate, so a directory repeating itself does not
    cost a second fetch. An answer that is not a station list is a RadioError,
    the same shape radio_stations uses, so a directory that is down is one
    failure to report rather than a traceback.
    """
    try:
        stations = json.loads(bytes(body).decode("utf-8", "replace"))
    except (ValueError, TypeError):
        raise RadioError("radio-browser sent an answer that is not JSON")
    if not isinstance(stations, list):
        raise RadioError("radio-browser sent an answer that is not a station list")

    candidates = []
    seen = set()

    def add(url) -> None:
        url = str(url or "").strip()
        if url and url not in seen:
            seen.add(url)
            candidates.append(url)

    for entry in stations:
        if isinstance(entry, dict):
            add(entry.get("favicon"))
    for entry in stations:
        if isinstance(entry, dict):
            add(homepage_favicon(entry.get("homepage")))
    return candidates


# Stream URL -> candidate logo URLs (possibly empty). A state refresh asks about
# the running station again and again while nothing about it changed, so the
# candidate list is asked once and kept. A definitively empty answer is kept too
# -- a station without a logo will not grow one a second later -- while a
# directory that could not be reached is *not* remembered, because the next
# refresh may well get through.
_favicon_cache = {}
_favicon_lock = threading.Lock()


def favicon_candidates_for(stream: str) -> list:
    """The logo candidate chain behind a stream address, asked once per URL."""
    with _favicon_lock:
        if stream in _favicon_cache:
            return _favicon_cache[stream]
    try:
        body = http_get(radio_byurl_url(stream), RADIO_TIMEOUT)
        candidates = radio_favicon_candidates(body)
    except (RadioError, ValueError):
        return []
    with _favicon_lock:
        _favicon_cache[stream] = candidates
    return candidates


def favicon_for(stream: str) -> str:
    """The best-guess logo URL behind a stream address, or "".

    The one-URL shape callers knew before the chain: the first candidate (see
    favicon_candidates_for). stream_art walks the whole chain; this stays for a
    caller that only wants to name a single URL. An empty chain is still "".
    """
    candidates = favicon_candidates_for(stream)
    return candidates[0] if candidates else ""


def fetch_remote(url: str, timeout: float, accept: str = "image/*") -> tuple:
    """Fetch a non-JSON resource: (content_type, body).

    The same ceiling as http_get -- the socket timeout is the fast path and the
    watchdog thread is the backstop name resolution ignores -- because a favicon
    URL must not be able to park the worker either. One byte past the maximum is
    read, so a body at the limit is kept and an oversize one is dropped by the
    caller. Only the header is returned alongside the bytes: this is how the
    caller tells an image apart from an HTML error page.
    """
    result = {}

    def fetch():
        try:
            request = urllib.request.Request(
                url, headers={"User-Agent": RADIO_UA, "Accept": accept})
            with urllib.request.urlopen(request, timeout=timeout) as response:
                result["type"] = response.headers.get("Content-Type") or ""
                result["body"] = response.read(RADIO_FAVICON_MAX + 1)
        except BaseException as exc:      # carried across, not raised here
            result["error"] = exc

    worker = threading.Thread(target=fetch, name="radio_fetch", daemon=True)
    worker.start()
    worker.join(timeout + RADIO_GRACE)
    if worker.is_alive():
        raise RadioError("the image did not answer within %gs"
                         % (timeout + RADIO_GRACE))
    if "error" in result:
        raise RadioError(error_text(result["error"]))
    return str(result.get("type") or ""), result.get("body") or b""


def stream_art(stream: str) -> tuple:
    """(data, mime) for a stream's station logo, or (b"", "").

    The directory's records for one stream disagree, so the logo is a *chain*
    of candidates (see radio_favicon_candidates) and the first one that turns
    out to be an image wins. Five rules, straight from the live directory:

    * The first record's favicon is not necessarily the good one: measured, the
      first answered 404 while the second answered a 30 KB PNG. A dead
      candidate is therefore not the end -- the next one is tried.
    * About a fifth of the `favicon` URLs are dead, and some answer with an HTML
      error page. Only `image/*` is an image; anything else is passed over.
    * Measured logos run to 400 KB; anything past RADIO_FAVICON_MAX is dropped
      rather than cached, and the next candidate is tried.
    * At most RADIO_ART_CANDIDATES fetches per stream, so a directory listing
      the same address a dozen times cannot turn into a dozen requests.
    * Every candidate failing -- or no candidate at all -- is (b"", ""): the
      surface keeps its glyph, and nothing is reported as an error.
    """
    for favicon in favicon_candidates_for(stream)[:RADIO_ART_CANDIDATES]:
        try:
            ctype, data = fetch_remote(favicon, RADIO_FAVICON_TIMEOUT)
        except RadioError:
            continue
        if not str(ctype).lower().startswith("image/"):
            continue
        if not data or len(data) > RADIO_FAVICON_MAX:
            continue
        return data, ctype
    return b"", ""


# ----------------------------------------------------------------- the bridge


class Bridge:
    def __init__(self):
        self.out_lock = threading.Lock()
        self.cmd_lock = threading.Lock()

        self.target = parse_target("", 6600)
        self.password = ""
        self.generation = 0  # bumped on every config change, retires old threads

        self.cmd = None
        self.idle = None
        self.connected = False

        # Liveness of the daemon, which is not the same as `connected`: the shell
        # can hold a socket to an MPD that no longer answers. None = not checked.
        self.health_ok = None
        self.health_fails = 0

        self.art_uri = ""       # what the art thread is fetching or last fetched
        self.art_sent = None    # last (uri, path) announced, to stay quiet on repeats
        self.art_missing = set()  # art keys MPD had no cover for; see request_art
        self.art_lock = threading.Lock()

        self.query_conn = None
        self.query_cv = threading.Condition()
        self.query_pending = []
        self.query_thread = None   # the worker; see ensure_query_worker()

        self.refresh_lock = threading.Lock()
        self.refreshing = False
        self.refresh_again = False
        self.last_state = None  # skip re-announcing a state nothing changed in

        self.stop = threading.Event()
        self.wake = threading.Event()

    # ------------------------------------------------------------- output

    def emit(self, payload: dict) -> None:
        line = json.dumps(payload, ensure_ascii=False)
        with self.out_lock:
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except (BrokenPipeError, ValueError):
                # The shell went away. Nothing left to talk to. A `ValueError` here
                # means the stream is closed -- the encoding case, the one a stale bar
                # could hide in, is handled once in main().
                self.stop.set()

    # -------------------------------------------------------- connection

    def apply_config(self, payload: dict) -> None:
        host = str(payload.get("host", "") or "").strip()
        port = payload.get("port", 6600)
        password = str(payload.get("password", "") or "")

        # An empty host means "wherever the rest of this user's MPD clients
        # look", which is MPD_HOST -- including its `password@host` spelling
        # and its unix socket paths. Only then; an explicit host in the panel
        # is a decision and should not be quietly overridden by a shell
        # profile the shell happened to inherit.
        if not host:
            env_host = (os.environ.get("MPD_HOST") or "").strip()
            if "@" in env_host and not env_host.startswith("@"):
                env_password, _, env_host = env_host.partition("@")
                if not password:
                    password = env_password
            host = env_host
            if not payload.get("port"):
                try:
                    port = int(os.environ.get("MPD_PORT") or 6600)
                except ValueError:
                    port = 6600

        target = parse_target(host, port)
        if target == self.target and password == self.password and self.connected:
            return
        self.target = target
        self.password = password
        self.generation += 1
        self.drop("settings changed")
        self.wake.set()

    def drop(self, reason: str) -> None:
        """Tear the connections down. The manager loop reconnects."""
        with self.cmd_lock:
            if self.cmd is not None:
                self.cmd.close()
                self.cmd = None
        idle = self.idle
        self.idle = None
        if idle is not None:
            idle.shutdown()
            idle.close()
        # The query socket is reopened by the next query rather than by the
        # manager: a shell showing the bar and nothing else should not hold a
        # third connection open for a browser nobody opened. Retire it instead
        # of closing it, because the query worker owns that socket and may be
        # blocked in a read on it right now -- closing the handles from this
        # thread is what used to kill that worker mid-read. The reader sees the
        # flag at its next read and reports a connection error; whoever holds
        # the socket (this call, if nobody is reading) closes what is left.
        with self.query_cv:
            query = self.query_conn
            self.query_conn = None
            self.query_pending = []
        if query is not None:
            query.retire()
            if not query.readers:
                query.close()
        # Both are "what the shell already knows" caches, and after a
        # reconnection it knows nothing -- it has been showing a disconnected
        # widget. Clearing them makes the first refresh speak up.
        self.last_state = None
        self.art_sent = None
        if self.connected:
            self.connected = False
            self.emit({"event": "disconnected", "error": reason})

    # ------------------------------------------------------------- health
    #
    # See HEALTH_INTERVAL above. One extra short-lived connection every interval,
    # nothing said while the answer does not change; the probe never touches the
    # command or idle sockets, so a wedged daemon cannot make it hang the rest of
    # the bridge.

    def probe_health(self) -> tuple:
        """Does the daemon greet? Its own connection, its own timeout."""
        conn = MPDConn(self.target, self.password)
        try:
            version = conn.connect(HEALTH_TIMEOUT)
            return True, version
        except (MPDError, OSError) as exc:
            return False, error_text(exc) or "no greeting"
        finally:
            conn.close()

    def health_tick(self, ok: bool, detail: str = "") -> None:
        """One probe result folded into the announced state.

        Deliberately no I/O: the decision (two misses, announce once per change)
        is the part worth testing, so it is separable from the socket.
        """
        if ok:
            self.health_fails = 0
            if self.health_ok is not True:
                self.health_ok = True
                self.emit({"event": "health", "ok": True, "detail": detail,
                           "target": describe(self.target)})
            return
        self.health_fails += 1
        if self.health_fails >= HEALTH_FAILS and self.health_ok is not False:
            self.health_ok = False
            self.emit({"event": "health", "ok": False, "detail": detail,
                       "fails": self.health_fails,
                       "target": describe(self.target)})

    def health_worker(self) -> None:
        while not self.stop.is_set():
            try:
                ok, detail = self.probe_health()
            except Exception as exc:      # a guard may not die on one bad probe
                ok, detail = False, error_text(exc)
            self.health_tick(ok, detail)
            if self.stop.wait(HEALTH_INTERVAL):
                return

    def manager(self) -> None:
        """Connect, then sit in `idle` until something changes or breaks."""
        backoff = 1.0
        while not self.stop.is_set():
            generation = self.generation
            # One snapshot per round, taken together so the check further down
            # can tell whether this round is still the current one. `apply_config`
            # can move the target while the connect below is in flight -- a
            # settings change is read within the second, a connect to a dead
            # host takes CONNECT_TIMEOUT -- and a connection to the address the
            # user just left must never be published, or announced, as the new
            # server: `next` would go to the old one while the bar names the
            # new one.
            target, password = self.target, self.password
            self.wake.clear()
            try:
                cmd = MPDConn(target, password)
                cmd.connect()
                cmd.sock.settimeout(CMD_TIMEOUT)
                idle = MPDConn(target, password)
                idle.connect()
                # No timeout on the idle connection: it is meant to sit there
                # for hours. A dead peer surfaces as a closed socket, which
                # readline reports, and TCP keepalive backs that up.
                idle.sock.settimeout(None)
            except (MPDError, OSError) as exc:
                if generation == self.generation:
                    self.emit({
                        "event": "disconnected",
                        "error": error_text(exc),
                        "target": describe(target),
                        "retryIn": backoff,
                    })
                self.wake.wait(backoff)
                # New settings deserve a fresh try rather than inheriting the
                # patience earned by the address the user just gave up on.
                backoff = 1.0 if generation != self.generation else min(15.0, backoff * 2)
                continue

            backoff = 1.0
            # The settings changed while this round was connecting, so what came
            # up belongs to the old address. Drop it unannounced and let the next
            # round build the connection that was actually asked for; the finally
            # below would not close these either, since it checks the generation
            # too -- which used to leave the socket behind for good.
            if generation != self.generation:
                cmd.close()
                idle.close()
                continue
            with self.cmd_lock:
                self.cmd = cmd
            self.idle = idle
            self.connected = True
            self.emit({
                "event": "connected",
                "version": cmd.version,
                "target": describe(target),
            })
            self.refresh()

            reason = "connection lost"
            try:
                while not self.stop.is_set() and generation == self.generation:
                    idle.send("idle " + " ".join(IDLE_SUBSYSTEMS))
                    pairs, _ = idle.read_response()
                    if generation != self.generation:
                        break
                    # MPD names the subsystems that woke us. `database` means
                    # the library itself changed -- songs added, removed or
                    # retagged -- which is the one thing a browsing client
                    # cannot infer from anything else it is told. It fires only
                    # when a scan actually found something, so a rescan that
                    # changes nothing costs no refetching.
                    for key, value in pairs:
                        if key.lower() == "changed" and value == "database":
                            # The one thing that may clear a remembered "no cover
                            # here": the album may have got one with the scan.
                            with self.art_lock:
                                self.art_missing.clear()
                            self.emit({"event": "database"})
                            break
                    self.refresh()
            except (MPDError, OSError) as exc:
                reason = error_text(exc) or reason
            finally:
                idle.close()
                # A no-op when the drop came from elsewhere -- a settings
                # change, or with_cmd finding the command socket dead -- since
                # drop() only announces a connection it still believed in.
                if generation == self.generation:
                    self.drop(reason)

    # ----------------------------------------------------------- commands

    def renew_cmd(self):
        """A fresh command socket in place of the current one, or None.

        The caller holds cmd_lock. The socket in use is closed only once its
        replacement is up, so a dial that fails leaves the caller with the
        connection it already had -- at worst a dead one, whose ordinary
        failure path is in cmd_call.
        """
        old = self.cmd
        conn = self.reconnect_cmd()
        if conn is None:
            return None
        if old is not None and old is not conn:
            old.close()
        return conn

    def cmd_call(self, handle: CommandConn, name: str, args,
                 repeatable: bool = False) -> tuple:
        """One command on the command connection, with the retry scoped to it.

        The unit of retry is the command, never the callback around it: a
        callback like `find_add` sends several commands, and repeating the
        callback repeats the ones that already ran. What may go out again is
        therefore decided per command:

        * a write that failed put nothing on the wire (`in_flight` was never
          set), so the command is repeated on a fresh socket -- provably a copy
          of nothing;
        * a reply that was lost after the write leaves the outcome unknown.
          Only the commands whose argument fully determines the result are
          repeated (`repeatable`): the transport buttons and the absolute
          setters. `next` and `previous` are the deliberate exception -- they
          are relative, and a doubled skip is the smaller evil against a press
          that does nothing. A mutation is never repeated here; it is reported
          instead, because appending the same album twice cannot be undone by
          pressing again.

        The caller (with_cmd) holds cmd_lock, so swapping the socket here cannot
        race a settings change.
        """
        wire = " ".join([name] + [quote(a) for a in args])
        try:
            handle.conn.send(wire)
        except MPDError:
            # Nothing reached the wire: repeat the command, not the callback.
            conn = self.renew_cmd()
            if conn is None:
                raise
            handle.conn = conn
            handle.repeated = True
            conn.send(wire)
        try:
            pairs, binary = handle.conn.read_response()
        except (MPDError, OSError):
            if not repeatable:
                raise
            # The command reached MPD; its reply did not come back. Repeat it
            # only when running it again lands in the same place.
            conn = self.renew_cmd()
            if conn is None:
                raise
            handle.conn = conn
            handle.repeated = True
            conn.send(wire)
            pairs, binary = conn.read_response()
        handle.conn.last_used = time.monotonic()
        return pairs, binary

    def with_cmd(self, fn, repeatable: bool = False):
        """Run fn against the command connection, or return None if it fails.

        A protocol ACK is the command's problem and leaves the connection
        alone. A dead socket is not necessarily a dead server: MPD closes a
        command connection after `connection_timeout`, 60 seconds by default,
        and a minute with no button pressed is the ordinary state of a paused
        player rather than a fault.

        Two things keep that from costing a press. The connection is replaced
        before it is used once it has sat idle past CMD_IDLE_RENEW -- a write to
        a socket MPD has just closed still succeeds, so waiting for the failure
        would mean the command looks delivered and no retry would touch it.
        Then, within a callback, a command is repeated on its own (cmd_call) and
        not as part of the callback: `repeatable` marks the callbacks that only
        read and can be run again whole, while a callback that writes has each
        of its commands judged separately. Only if nothing can be salvaged is
        the connection given up on, which drops both sockets and lets the
        manager start again.

        The connection is given up either way -- a reply that stopped halfway
        leaves the stream out of step with every command after it, and this
        lock is also held by whichever thread is waiting on that reply.
        """
        with self.cmd_lock:
            conn = self.cmd
            if conn is None:
                return None
            # MPD hangs up an idle command connection. Replace the socket before
            # a command is written to it rather than after it has swallowed one.
            if conn.last_used and not conn.in_flight \
                    and time.monotonic() - conn.last_used > CMD_IDLE_RENEW:
                fresh = self.renew_cmd()
                if fresh is not None:
                    conn = fresh
            handle = CommandConn(self, conn)
            try:
                return fn(handle)
            except MPDCommandError as exc:
                self.emit({"event": "ack", "error": str(exc)})
                return None
            except (MPDError, OSError) as exc:
                # Read the flag before close(); closing says nothing about it.
                delivered = handle.conn.in_flight
                repeated = handle.repeated
                handle.conn.close()
                self.cmd = None

                # A repeat of the whole callback needs a callback that cannot
                # change anything: the read-only ones. A callback that writes
                # had its retry per command already, and re-running it here is
                # exactly the duplicate this guard exists to prevent.
                replacement = None
                if repeatable:
                    replacement = self.reconnect_cmd()
                if replacement is not None:
                    try:
                        return fn(CommandConn(self, replacement))
                    except MPDCommandError as retry_exc:
                        self.emit({"event": "ack", "error": str(retry_exc)})
                        return None
                    except (MPDError, OSError) as retry_exc:
                        replacement.close()
                        self.cmd = None
                        exc = retry_exc

                error = error_text(exc) or "connection lost"
                if delivered and not repeatable and not repeated:
                    # The command may well have run. Saying only "connection
                    # lost" invites the user to press again, which is exactly
                    # the duplicate this guard exists to prevent.
                    error = "%s (sent, reply lost -- not repeated)" % error
                # Unblocks the manager's idle read so it reconnects at once
                # rather than at the next server-side event.
                idle = self.idle
                if idle is not None:
                    idle.shutdown()
                self.connected = False
                self.emit({"event": "disconnected", "error": error})
                return None

    def reconnect_cmd(self):
        """A fresh command socket, or None. The caller holds cmd_lock."""
        try:
            conn = MPDConn(self.target, self.password)
            conn.connect()
            conn.sock.settimeout(CMD_TIMEOUT)
        except (MPDError, OSError):
            return None
        self.cmd = conn
        return conn

    def refresh(self) -> None:
        """Read state and announce it, coalescing concurrent callers.

        Both the idle loop and every command ask for a refresh, and during a
        burst those pile onto the one command connection. A caller arriving
        while a read is in flight leaves a note instead of queueing: the
        running read loops once more, so the last word is always current
        without a request per event.
        """
        with self.refresh_lock:
            if self.refreshing:
                self.refresh_again = True
                return
            self.refreshing = True
        try:
            while True:
                self.refresh_once()
                with self.refresh_lock:
                    if not self.refresh_again:
                        return
                    self.refresh_again = False
                time.sleep(REFRESH_MIN_GAP)
        finally:
            with self.refresh_lock:
                self.refreshing = False
                self.refresh_again = False

    def refresh_once(self) -> None:
        def run(conn):
            status = to_dict(conn.command("status", repeatable=True)[0])
            song = to_dict(conn.command("currentsong", repeatable=True)[0])
            return status, song

        # The one read-only caller: repeating `status` and `currentsong` costs
        # a round trip and can change nothing, so it keeps the retry that the
        # buttons must not have.
        result = self.with_cmd(run, repeatable=True)
        if result is None:
            return
        status, song = result
        state = {"event": "state", "status": status, "song": song}
        if state != self.last_state:
            self.last_state = state
            self.emit(state)
        self.request_art(song)

    def do(self, *command, repeatable: bool = False) -> None:
        # `repeatable` says the command has a defined target and may be sent
        # again if its reply was lost -- the transport buttons and the absolute
        # setters. A mutation is never repeated on a lost reply.
        self.with_cmd(lambda conn: conn.command(*command, repeatable=repeatable))
        # MPD will announce this through idle anyway, but that round trip is
        # visible as a lag on the button. Ask now and let the idle event be a
        # harmless second refresh.
        self.refresh_soon()

    def refresh_soon(self) -> None:
        threading.Thread(target=self.refresh, daemon=True).start()

    def toggle(self) -> None:
        def run(conn):
            status = to_dict(conn.command("status", repeatable=True)[0])
            state = status.get("state", "stop")
            if state == "play":
                conn.command("pause", 1, repeatable=True)
            elif state == "pause":
                conn.command("pause", 0, repeatable=True)
            else:
                # `play` with no argument resumes at the current queue
                # position, which is what a play button should do after a stop.
                conn.command("play", repeatable=True)
            return True

        self.with_cmd(run)
        self.refresh_soon()

    # ------------------------------------------------------------ mutations
    #
    # Everything the browser does to the queue and to stored playlists. These
    # run on the command connection like the transport buttons do -- they are
    # all single round trips, and ordering against a play/pause matters more
    # than the microsecond of contention.

    def mutate(self, payload: dict) -> None:
        op = str(payload.get("op", ""))
        uri = str(payload.get("uri", "") or "")
        name = str(payload.get("name", "") or "")

        def one(*command, repeatable=False):
            self.with_cmd(lambda conn: conn.command(
                *command, repeatable=repeatable))

        # A position or an id names the target, so replaying it lands in the
        # same place; the buttons that move the current song are in do().
        if op == "playid":
            one("playid", int(payload.get("id", 0)), repeatable=True)
        elif op == "playpos":
            one("play", int(payload.get("pos", 0)), repeatable=True)
        elif op == "add" and uri:
            one("add", uri)
        elif op == "addplay" and uri:
            self.with_cmd(lambda conn: self.add_and_play(conn, uri))
        elif op == "insert" and uri:
            self.with_cmd(lambda conn: self.add_after_current(conn, uri))
        elif op in ("findadd", "findplay"):
            # Everything matching a filter, in one command. The browser adds an
            # artist by adding a filter rather than by walking their albums and
            # sending nine hundred `add` lines, which the server would answer
            # nine hundred times.
            self.with_cmd(lambda conn: self.find_add(
                conn, payload.get("filter") or [], op == "findplay"))
        elif op == "searchadd":
            # The same, for a free-text search: one command appends every hit. With a
            # tag it stays inside that category -- the scoped field of the library tabs.
            term = str(payload.get("term", "") or "").strip()
            scope = str(payload.get("tag", "") or "").strip()
            if term:
                self.with_cmd(lambda conn: self.search_add(conn, term, scope))
        elif op == "remove":
            one("deleteid", int(payload.get("id", 0)))
        elif op == "move":
            one("move", int(payload.get("from", 0)), int(payload.get("to", 0)))
        elif op == "clear":
            one("clear")
        elif op == "shuffle":
            one("shuffle")
        elif op == "crop":
            self.with_cmd(self.crop_queue)
        elif op == "loadplaylist" and name:
            one("load", name)
        elif op == "saveplaylist" and name:
            one("save", name)
        elif op == "rmplaylist" and name:
            one("rm", name)
        elif op == "renameplaylist" and name:
            one("rename", name, str(payload.get("to", "")))
        elif op == "playlistadd" and name and uri:
            one("playlistadd", name, uri)
        elif op == "playlistdelete" and name and payload.get("pos") is not None:
            # One song out of a stored playlist. MPD addresses it by position,
            # not by uri, so the caller sends the row's index.
            one("playlistdelete", name, int(payload.get("pos", 0)))
        elif op == "playlistclear" and name:
            one("playlistclear", name)
        else:
            return
        self.refresh_soon()

    def queue_length(self, conn: CommandConn) -> int:
        status = to_dict(conn.command("status", repeatable=True)[0])
        try:
            return int(status.get("playlistlength", 0))
        except ValueError:
            return 0

    def add_and_play(self, conn: CommandConn, uri: str) -> bool:
        """Append, then start at the first thing appended.

        `addid` would hand back an id to play directly, but it takes a file and
        this takes whatever the browser had selected -- which is as often a
        directory or an album's worth of songs. Reading the length first says
        where that lands without needing to know how much of it there was.
        """
        start = self.queue_length(conn)
        conn.command("add", uri)
        if self.queue_length(conn) > start:
            # `play <position>` names where to start, so it is idempotent; the
            # `add` before it is not and stays unrepeated.
            conn.command("play", start, repeatable=True)
        return True

    def add_after_current(self, conn: CommandConn, uri: str) -> bool:
        """Append, then move what was appended in behind the playing song."""
        status = to_dict(conn.command("status", repeatable=True)[0])
        start = self.queue_length(conn)
        conn.command("add", uri)
        end = self.queue_length(conn)
        if end <= start:
            return True
        current = status.get("song")
        if current is None:
            return True
        try:
            target = int(current) + 1
        except ValueError:
            return True
        if target >= start:
            return True
        conn.command("move", "%d:%d" % (start, end), target)
        return True

    def find_add(self, conn: CommandConn, filters, then_play: bool) -> bool:
        args = self.filter_args(conn, filters)
        if not args:
            return False
        start = self.queue_length(conn)
        conn.command("findadd", *args)
        end = self.queue_length(conn)
        if end == start:
            # A filter that matches nothing is not an error to MPD: it answers
            # OK and adds no songs. Silence is the wrong answer to a keypress,
            # and after a database update it is the likely one -- the browser
            # may still be showing tags the library no longer has.
            self.emit({"event": "ack",
                       "error": "nothing in the library matches that any more"})
            return True
        if then_play:
            conn.command("play", start, repeatable=True)
        return True

    def search_add(self, conn: CommandConn, term: str, tag: str = "") -> bool:
        """Everything a search matches, appended in one command.

        `searchadd` takes the same filter expression `search` does, and it
        answers OK even when nothing matches -- the same silence find_add
        refuses to pass on. A `tag` narrows it to one category: that is what the
        scoped field in the library tabs hands in -- "append the rows I am looking
        at", not everything that happens to mention the word somewhere.
        """
        if version_at_least(conn.version, 0, 21):
            args = [contains_expression(tag, term) if tag
                    else "(any contains '%s')" % quote_filter_value(term)]
        else:
            args = [tag, term] if tag else ["any", term]
        start = self.queue_length(conn)
        conn.command("searchadd", *args)
        if self.queue_length(conn) == start:
            self.emit({"event": "ack",
                       "error": "nothing in the library matches “%s”" % term})
        return True

    def crop_queue(self, conn: CommandConn) -> bool:
        """Everything but the playing song. Nothing playing means nothing kept."""
        status = to_dict(conn.command("status", repeatable=True)[0])
        current = status.get("song")
        if current is None:
            conn.command("clear")
            return True
        position = int(current)
        length = self.queue_length(conn)
        # Tail first: deleting the head would renumber the tail underneath us.
        if length > position + 1:
            conn.command("delete", "%d:%d" % (position + 1, length))
        if position > 0:
            conn.command("delete", "0:%d" % position)
        return True

    # -------------------------------------------------------------- queries

    def submit_query(self, request: dict) -> None:
        with self.query_cv:
            self.query_pending.append(request)
            self.query_cv.notify()
        # A request nobody is waiting for is the one failure the pane cannot
        # see: the spinner turns and no answer ever comes.
        self.ensure_query_worker()

    def ensure_query_worker(self) -> None:
        """Run the query worker, starting one if it is not there.

        The worker is meant to live as long as the bridge, and a connection
        taken away by a settings change now reaches it as a connection error
        instead of killing it. Anything else that ends it -- an error no code
        path expected -- would leave every queue, album, artist and file tab
        waiting for an answer nobody will ever produce, so the request that
        arrives afterwards starts a fresh worker rather than queueing behind a
        dead thread. Checked under the same condition the queue uses, so two
        requests arriving at once cannot start two workers.
        """
        with self.query_cv:
            if self.query_thread is not None and self.query_thread.is_alive():
                return
            self.query_thread = threading.Thread(target=self.query_worker,
                                                 name="query_worker", daemon=True)
            self.query_thread.start()

    def query_worker(self) -> None:
        while not self.stop.is_set():
            with self.query_cv:
                while not self.query_pending and not self.stop.is_set():
                    self.query_cv.wait(0.5)
                if self.stop.is_set():
                    return
                request = self.query_pending.pop(0)
                channel = request.get("channel")
                # A newer request on the same channel has already made this one's
                # answer stale. Typing into the search box is the case this is
                # for: eight keystrokes, one query, the last one.
                if channel and any(r.get("channel") == channel for r in self.query_pending):
                    continue
            self.run_query(request)

    def query_conn_for(self, generation: int) -> MPDConn:
        with self.query_cv:
            conn = self.query_conn
        if conn is not None:
            return conn
        conn = MPDConn(self.target, self.password)
        conn.connect()
        conn.sock.settimeout(CMD_TIMEOUT)
        # This connection answers `art` as well as the list queries, and a cover
        # arrives in chunks of binarylimit bytes -- 8KB by default, which is 400
        # round trips for a 3MB scan. Servers older than 0.22 reject the command
        # and keep their default.
        try:
            conn.command("binarylimit", ART_CHUNK)
        except MPDCommandError:
            pass
        with self.query_cv:
            # A config change while this was connecting retires it before it
            # ever answers anything.
            if generation != self.generation:
                conn.close()
                raise MPDError("settings changed")
            self.query_conn = conn
        return conn

    def drop_query_conn(self, conn: MPDConn) -> None:
        with self.query_cv:
            if self.query_conn is conn:
                self.query_conn = None
        conn.close()

    def run_query(self, request: dict) -> None:
        generation = self.generation
        kind = str(request.get("kind", ""))
        answer = {
            "event": "result",
            "id": request.get("id"),
            "kind": kind,
            "channel": request.get("channel", ""),
        }

        if kind == "radio_search":
            # Deliberately before the loop below: this query takes no MPD
            # connection and sends no MPD command at all. A directory that is
            # unreachable must therefore never be reported as a broken MPD, and
            # the radio tab must not be able to tell whether MPD is up.
            try:
                rows = self.radio_search(request)
                answer["rows"] = rows
                answer.pop("error", None)
                note_truncated(answer, request, rows)
            except (RadioError, ValueError) as exc:
                answer["rows"] = []
                answer["error"] = error_text(exc)
            if generation == self.generation and not self.stop.is_set():
                self.emit(answer)
            return

        # Two attempts, because the query connection is held open between
        # questions and MPD closes an idle one after connection_timeout -- 60
        # seconds by default. The first browse after a pause would otherwise
        # report "connection closed by server" for whichever tab was opened
        # first, and work from then on, which is a confusing way to say that a
        # socket had gone stale. A reconnect costs a round trip; the error cost
        # a tab.
        for attempt in (0, 1):
            conn = None
            try:
                conn = self.query_conn_for(generation)
                rows = self.execute_query(conn, kind, request)
                answer["rows"] = rows
                answer.pop("error", None)
                # The pane says so rather than quietly showing a prefix of the
                # answer as though it were all of it.
                note_truncated(answer, request, rows)
                break
            except MPDCommandError as exc:
                # The server understood and refused: an unknown playlist, a
                # filter it does not like. The connection is fine, the answer
                # will not change on a second ask, and the pane wants to hear
                # about it.
                answer["rows"] = []
                answer["error"] = str(exc)
                break
            except (MPDError, OSError) as exc:
                if conn is not None:
                    self.drop_query_conn(conn)
                answer["rows"] = []
                answer["error"] = error_text(exc)
                if generation != self.generation or self.stop.is_set():
                    break
                # The second attempt starts from a fresh socket. If that fails
                # too, the server really is unreachable and the error stands.

        if generation == self.generation and not self.stop.is_set():
            self.emit(answer)

    def radio_search(self, request: dict) -> list:
        """Stations from radio-browser.info for one search.

        A query like the others -- same `result` event, same channel, same
        generation -- but no MPD connection is taken for it and no command is
        sent. The lookup is against a public directory, so a search must not
        depend on the player being up, and it must not be able to change it:
        this writes nothing anywhere.

        `search` (or `term`) is the text, `country` narrows by ISO country code,
        `tag` by genre, `limit` caps the rows. Everything that can go wrong
        arrives as RadioError and run_query turns it into the error reply the
        browsing queries give, so a directory that is down is a message in the
        radio tab rather than a dead bridge.

        The HTTP call blocks -- this is the query worker -- but only for as long
        as http_get allows, which is bounded even when the socket and the
        resolver both ignore their own timeouts.
        """
        search = str(request.get("search") or request.get("term") or "").strip()
        country = str(request.get("country") or "").strip()
        tag = str(request.get("tag") or "").strip()
        # Nothing to ask: no station name and no narrowing. A country or a tag on
        # its own *is* a question -- that is how the panel browses the directory
        # ("which German stations are there", "which jazz stations").
        if not search and not country and not tag:
            return []
        try:
            limit = int(request.get("limit", RADIO_ROW_LIMIT))
        except (TypeError, ValueError):
            limit = RADIO_ROW_LIMIT
        limit = max(1, min(RADIO_ROW_LIMIT, limit))
        body = http_get(radio_url(search, country, tag, limit), RADIO_TIMEOUT)
        return radio_stations(body, limit)

    def filter_args(self, conn: CommandConn, filters) -> list:
        """The tail of a find/list/search command for a set of tag conditions.

        MPD 0.21 introduced the filter expression and has spent every release
        since deprecating the tag/value spelling that came before it. Both are
        still accepted here because the plugin has no say in which server it is
        pointed at, and 0.20 is still what a NAS ships.
        """
        if not filters:
            return []
        pairs = [(str(t), str(v)) for t, v in filters if str(t)]
        if not pairs:
            return []
        if version_at_least(conn.version, 0, 21):
            clauses = ["(%s == '%s')" % (tag, quote_filter_value(value))
                       for tag, value in pairs]
            return ["(" + " AND ".join(clauses) + ")" if len(clauses) > 1 else clauses[0]]
        flat = []
        for tag, value in pairs:
            flat.extend([tag, value])
        return flat

    def execute_query(self, conn: MPDConn, kind: str, request: dict) -> list:
        # `search a` on a ten thousand song library is a real thing to type, and
        # its answer is four megabytes of JSON on one line. The pane asking says
        # how many rows it can use; nothing asks for more than it will show.
        try:
            limit = int(request.get("limit", QUERY_ROW_LIMIT))
        except (TypeError, ValueError):
            limit = QUERY_ROW_LIMIT
        limit = max(1, min(QUERY_ROW_LIMIT, limit))

        if kind == "queue":
            return split_entries(conn.command("playlistinfo")[0],
                                 markers=("file",), fields=SONG_FIELDS, limit=limit)

        if kind == "lsinfo":
            rows = split_entries(conn.command("lsinfo", request.get("path", ""))[0],
                                 fields=SONG_FIELDS, limit=limit)
            # MPD returns a directory's contents in database order, which is
            # insertion order, which is nothing a person can predict. Folders
            # first, then names, is what every file manager does.
            rows.sort(key=lambda r: (
                0 if r["type"] == "directory" else (1 if r["type"] == "playlist" else 2),
                entry_name(r).lower(),
            ))
            return rows

        if kind == "list":
            tag = str(request.get("tag", "album"))
            term = str(request.get("search", "")).strip()
            if term:
                # Scoped search: one category. Written as a case-insensitive regex,
                # because `contains` compares case-sensitively here -- "iam" missed the
                # artist "IAM" (5 hits) while `=~ '(?i)iam'` finds it (6). MPD wants the
                # whole expression as a single argument (the bridge's quoting does
                # that), and this MPD cannot combine two tags with OR, which is exactly
                # the "only this category" the field is for.
                # 0.20 has no filter expressions; there it is an exact match, which is
                # still better than nothing on a NAS that old.
                if not version_at_least(conn.version, 0, 21):
                    args = [tag, tag, term]
                else:
                    # The pane narrows a nested list (one artist, one genre) and
                    # searches inside it in the same request, so both conditions
                    # belong in the one filter a list command carries, joined with
                    # AND like filter_args() joins its own clauses. Answered with
                    # the term alone, the narrowing was silently lost: artist
                    # "Little Dragon" plus "New" came back as every "New" album in
                    # the library (measured: 12 rows instead of the one album,
                    # other artists among them).
                    scope = self.filter_args(conn, request.get("filter") or [])
                    try:
                        clauses = scope + [contains_expression(tag, term)]
                        args = [tag, "(" + " AND ".join(clauses) + ")"
                                if len(clauses) > 1 else clauses[0]]
                        rows = tag_values(conn.command("list", *args)[0], tag, limit=limit)
                    except MPDCommandError:
                        # An MPD built without regex support: a case-sensitive hit
                        # still beats no hit at all. This retry is about finding a
                        # spelling the server accepts, so it stays the term alone --
                        # the same narrowing the old code answered with, kept here
                        # rather than risking a second refusal on the scope.
                        args = [tag, "(%s contains '%s')" % (tag, quote_filter_value(term))]
                        rows = tag_values(conn.command("list", *args)[0], tag, limit=limit)
                    rows.sort(key=lambda r: r["value"].lower())
                    return rows
            else:
                args = [tag] + self.filter_args(conn, request.get("filter") or [])
            rows = tag_values(conn.command("list", *args)[0], tag, limit=limit)
            rows.sort(key=lambda r: r["value"].lower())
            return rows

        if kind == "find":
            args = self.filter_args(conn, request.get("filter") or [])
            if not args:
                return []
            rows = split_entries(conn.command("find", *args)[0],
                                 markers=("file",), fields=SONG_FIELDS, limit=limit)
            if request.get("sort") == "track":
                rows.sort(key=lambda r: (number(r.get("disc")), number(r.get("track")),
                                         r.get("file", "")))
            return rows

        if kind == "search":
            term = str(request.get("term", "")).strip()
            if not term:
                return []
            if version_at_least(conn.version, 0, 21):
                args = ["(any contains '%s')" % quote_filter_value(term)]
            else:
                args = ["any", term]
            return split_entries(conn.command("search", *args)[0],
                                 markers=("file",), fields=SONG_FIELDS, limit=limit)

        if kind == "songinfo":
            # One song, every tag it has. The browsing queries whitelist fields
            # because they carry ten thousand rows; this one carries a single
            # row that a person is reading, so it keeps everything MPD sends --
            # labels, MusicBrainz ids, sort names, the audio format.
            uri = str(request.get("file", ""))
            if not uri:
                return []
            args = self.filter_args(conn, [["file", uri]])
            return split_entries(conn.command("find", *args)[0],
                                 markers=("file",), fields=None, limit=1)

        if kind == "art":
            # The cover for any song, not just the one playing. Same cache and
            # the same key -- by album rather than by track -- so browsing an
            # album the player already fetched costs nothing.
            uri = str(request.get("uri", ""))
            if not uri:
                return []
            key = art_key({
                "file": uri,
                "album": str(request.get("album", "")),
                "albumartist": str(request.get("albumartist", "")),
            })
            path = cached_art(key)
            if not path:
                data, mime = fetch_art(conn, uri)
                if data:
                    path = store_art(key, data, mime)
            return [{"type": "art", "path": path}]

        if kind == "listplaylists":
            rows = split_entries(conn.command("listplaylists")[0], markers=("playlist",),
                                 limit=limit)
            rows.sort(key=lambda r: r.get("playlist", "").lower())
            return rows

        if kind == "playlist":
            name = str(request.get("name", ""))
            if not name:
                return []
            return split_entries(conn.command("listplaylistinfo", name)[0],
                                 markers=("file",), fields=SONG_FIELDS, limit=limit)

        raise MPDCommandError("unknown query: %s" % kind)

    # --------------------------------------------------------------- art

    def announce_art(self, uri: str, path: str, mime: str = "") -> None:
        # Every status refresh passes through here, and most of them are about
        # the same song. Announcing only changes keeps the pipe quiet.
        if self.art_sent == (uri, path):
            return
        self.art_sent = (uri, path)
        self.emit({"event": "art", "uri": uri, "path": path, "mime": mime})

    def request_art(self, song: dict) -> None:
        uri = song.get("file", "")
        if not uri:
            self.announce_art("", "")
            return
        key = art_key(song)
        cached = cached_art(key)
        if cached:
            self.announce_art(uri, cached)
            return
        with self.art_lock:
            # Every refresh asks, and most of them are about the same song. An
            # album MPD has no cover for used to be fetched again each time --
            # measured: ten plain refreshes, ten connections, each with
            # binarylimit/albumart/readpicture. The guard below is per uri and
            # was cleared after the attempt, which is exactly the state a later
            # refresh starts from. A remembered "nothing there" is kept until the
            # library changes (the `database` idle event), which is the only
            # thing that can make a cover appear.
            if key in self.art_missing:
                return
            if self.art_uri == uri:
                return
            self.art_uri = uri
        threading.Thread(target=self.art_worker, args=(uri, key, self.generation),
                         daemon=True).start()

    def art_worker(self, uri: str, key: str, generation: int) -> None:
        # Its own connection: a cover can be megabytes, and holding the command
        # lock for that long would make the transport buttons feel stuck. A
        # stream takes no MPD connection at all -- its logo comes from the public
        # directory -- but it is the same worker, off the play/pause path.
        path = ""
        mime = ""
        conn = None
        # "MPD was asked and had nothing" is an answer worth remembering; a
        # connection that broke on the way is not. Remembering that one would
        # hide the cover until a rescan, when the next refresh may well get
        # through.
        no_cover = False
        try:
            if is_stream_uri(uri):
                data, mime = stream_art(uri)
                no_cover = not data
                if data:
                    path = store_art(key, data, mime)
            else:
                conn = MPDConn(self.target, self.password)
                conn.connect()
                conn.sock.settimeout(CMD_TIMEOUT)
                # MPD hands binary back in chunks of `binarylimit` bytes, 8KB by
                # default, so a 3MB cover would be 400 round trips. Servers older
                # than 0.22 ACK this and keep their default, which still works.
                try:
                    conn.command("binarylimit", ART_CHUNK)
                except MPDCommandError:
                    pass
                data, mime = fetch_art(conn, uri)
                no_cover = not data
                if data:
                    path = store_art(key, data, mime)
        except (MPDError, OSError):
            path = ""
        finally:
            if conn is not None:
                conn.close()
            with self.art_lock:
                # Before the uri guard is let go: a caller that sees the guard
                # free -- the next refresh -- has to see the answer too.
                if no_cover and generation == self.generation:
                    self.art_missing.add(key)
                if self.art_uri == uri:
                    self.art_uri = ""
        if generation == self.generation and not self.stop.is_set():
            self.announce_art(uri, path, mime)

    # ------------------------------------------------------------- stdin

    def handle(self, line: str) -> None:
        line = line.strip()
        if not line:
            return
        verb, _, rest = line.partition(" ")
        rest = rest.strip()

        if verb == "config":
            try:
                self.apply_config(json.loads(rest or "{}"))
            except ValueError:
                pass
        elif verb == "quit":
            self.stop.set()
        elif verb == "refresh":
            self.refresh_soon()
        elif verb == "toggle":
            self.toggle()
        elif verb == "play":
            self.do("play", repeatable=True)
        elif verb == "pause":
            self.do("pause", 1, repeatable=True)
        elif verb == "resume":
            self.do("pause", 0, repeatable=True)
        elif verb == "stop":
            self.do("stop", repeatable=True)
        elif verb == "next":
            # `next` is relative: repeating it skips a song. That is accepted
            # here -- a doubled skip is the smaller evil against a press that
            # does nothing, which is what the lost reply used to mean.
            self.do("next", repeatable=True)
        elif verb == "prev":
            self.do("previous", repeatable=True)
        elif verb == "seek":
            try:
                # absolute seconds: the same position either way
                self.do("seekcur", "%.3f" % float(rest), repeatable=True)
            except ValueError:
                pass
        elif verb == "volume":
            try:
                # absolute volume: the same level either way
                self.do("setvol", max(0, min(100, int(float(rest)))),
                        repeatable=True)
            except ValueError:
                pass
        elif verb == "setopt":
            name, _, value = rest.partition(" ")
            if name in ("repeat", "random", "single", "consume"):
                # absolute setting, not a toggle: replaying it is a no-op
                self.do(name, value.strip() or "0", repeatable=True)
        elif verb == "play_id":
            try:
                # an id names the song, so replaying it lands on the same one
                self.do("playid", int(rest), repeatable=True)
            except ValueError:
                pass
        elif verb in ("update", "rescan"):
            # Deliberately not repeatable on a lost reply: a scan is a side
            # effect, and two scans where one was asked for is a surprise. The
            # idle renew above is what keeps the first press after a pause from
            # being swallowed.
            # An optional path limits the scan to one folder under the music
            # directory -- seconds instead of minutes when the library sits on a
            # network share. `update` reads only new and changed files; `rescan`
            # also re-reads unchanged ones and drops entries for files that are
            # gone, so it is for deletions and renames.
            where = rest.strip()
            self.do(verb, *([where] if where else []))
        elif verb == "cmd":
            try:
                payload = json.loads(rest or "{}")
            except ValueError:
                return
            if isinstance(payload, dict):
                # Off the stdin thread: a mutation waits on the command lock,
                # and a transport button queued behind a blocked one would look
                # like a dead widget.
                threading.Thread(target=self.mutate, args=(payload,), daemon=True).start()
        elif verb == "query":
            try:
                payload = json.loads(rest or "{}")
            except ValueError:
                return
            if isinstance(payload, dict):
                self.submit_query(payload)

    def run(self) -> int:
        threading.Thread(target=self.manager, daemon=True).start()
        threading.Thread(target=self.health_worker, daemon=True).start()
        self.ensure_query_worker()
        try:
            while not self.stop.is_set():
                line = sys.stdin.readline()
                if not line:
                    break  # the shell closed our stdin
                self.handle(line)
        except KeyboardInterrupt:
            pass
        self.stop.set()
        self.generation += 1
        with self.query_cv:
            self.query_cv.notify_all()
        self.drop("shutting down")
        return 0


def main() -> int:
    # The widget reads our stdout as UTF-8 JSON lines. A title outside ASCII would
    # otherwise raise UnicodeEncodeError -- which *is* a ValueError, so the stdout
    # writer below could not tell it apart from a closed pipe: it would set the stop
    # flag and swallow every later event, leaving a stale bar and nothing in the log
    # to explain it. Make the stream tolerant instead of widening that except.
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass

    # A cover written to a closed stdout should end the process quietly rather
    # than print a traceback into the shell's log.
    try:
        return Bridge().run()
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
